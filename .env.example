# ============================================================
# Пример файла переменных окружения.
#
# Скопируйте в .env.local (не коммитится в Git) и заполните
# реальные значения. Реальные секреты НЕ должны попадать в Git.
# ============================================================

# Базовый URL сайта (используется для metadata, sitemap, canonical URL)
# Локально: http://localhost:3000 | Прод: https://dmbugaev.dev (пример)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Название сайта (используется в metadata и шаблонах заголовков)
NEXT_PUBLIC_SITE_NAME="Dmbugaev — Portfolio"
