# EditorConfig — единые настройки редактора для всех участников проекта
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# В Markdown двойные пробелы в конце строки значимы (перенос внутри абзаца)
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
